{
  "name": "wait-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight HTTP callback-based task queue and concurrency scheduler",
  "main": "dist/app.js",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "pnpm build && node --test test/*.test.js",
    "test:watch": "npm run build && node --test --watch test/*.test.js",
    "build": "tsc",
    "start": "node dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cron": "^3.1.6",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-pino-logger": "^4.0.0",
    "@koa/router": "^15.7.0",
    "mysql2": "^3.23.3",
    "pino": "^8.21.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/koa": "^2.13.12",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-pino-logger": "^3.0.4",
    "@types/node": "^20.10.2",
    "typescript": "^5.3.2"
  },
  "pnpm": {
    "overrides": {
      "dottie": "^2.0.7",
      "lodash": "^4.18.1",
      "qs": "^6.15.3",
      "uuid": "^11.1.1",
      "validator": "^13.15.35"
    }
  }
