# Local-only port bindings. Expose through an authenticated gateway in production.
BIND_ADDRESS=127.0.0.1
API_PORT=3000
DASHBOARD_PORT=3001
MOCK_HOOK_PORT=3101

# Replace these local-only defaults before any shared or production deployment.
# Generate independent values with: openssl rand -hex 32
DB_DATABASE=waitqueue
DB_USER=waitqueue
DB_PASSWORD='replace-with-a-strong-password'
DB_ROOT_PASSWORD='replace-with-a-different-strong-password'

# Scheduler settings
HOOK_TIMEOUT_MS=10000
CHECK_TASK_DIFF_CRON=0 * * * * *
CRON_TIMEZONE=Asia/Shanghai
